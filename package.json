    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^24.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.3",
    "vite": "^8.0.16",
